# Neon Database (crm-service)
DATABASE_URL='postgresql://...'

# API key that authenticates inbound service-to-service calls (apiKeyAuth).
# REQUIRED — the service crashes at boot if this is missing.
CRM_SERVICE_API_KEY='your-crm-service-api-key'

# Runs Service (mandatory run tracking)
RUNS_SERVICE_URL='https://runs.mcpfactory.org'
RUNS_SERVICE_API_KEY='your-runs-service-api-key'

# Chat Service (the ONLY external/metered call — column typing via POST /complete)
CHAT_SERVICE_URL='http://chat-service.railway.internal'
CHAT_SERVICE_API_KEY='your-chat-service-api-key'

# Sentry (error tracking)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Server
PORT=3010
