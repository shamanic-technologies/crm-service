# Neon Database (crm-service)
CRM_SERVICE_DATABASE_URL='postgresql://...'

# API key that authenticates inbound service-to-service calls (apiKeyAuth).
# REQUIRED — the service crashes at boot if this is missing.
CRM_SERVICE_API_KEY='your-crm-service-api-key'

# Runs Service (mandatory run tracking)
RUNS_SERVICE_URL='https://runs.mcpfactory.org'
RUNS_SERVICE_API_KEY='your-runs-service-api-key'

# Chat Service (the ONLY external/metered call — column typing via POST /complete)
CHAT_SERVICE_URL='http://chat-service.railway.internal'
CHAT_SERVICE_API_KEY='your-chat-service-api-key'

# Sentry (error tracking)
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Server
PORT=3010

# ─── Matrix DM ingestion (WhatsApp / Telegram / Discord) ─────────────────────
# The homeserver (conduwuit + mautrix bridges) runs as containers on the box,
# OUTSIDE this repo. crm-service only CONSUMES it, read-only, over the standard
# client-server API. Without these vars the sync endpoint fails loud.
MATRIX_HOMESERVER_URL='http://conduwuit:6167'
MATRIX_ACCESS_TOKEN='your-matrix-access-token'

# Ingestion floor: events strictly older than this date are NEVER mirrored into
# bronze. Bronze normally means "everything" — this is the one exception.
MATRIX_INGESTION_FLOOR='2026-08-01'

# Named chat CONFIG for reading a conversation thread into the gold leads layer,
# as "<provider>/<model>". Switching to a cheaper provider is a change HERE, not
# in code.
CRM_LEAD_READING_CHAT_CONFIG='anthropic/haiku'

# Optional tuning (defaults shown)
# MATRIX_SYNC_TIMEOUT_MS=30000
# MATRIX_SYNC_MAX_PAGES=20
# CRM_LEAD_THREAD_WINDOW=60

# ─── GoHighLevel (third CRM source) ──────────────────────────────────────────
# The customer's GoHighLevel Private Integration Token is NOT stored here and
# NOT stored by crm-service at all. key-service holds it, scoped to an
# (organisation, brand) pair, and every call resolves it at
# GET /keys/brands/{brandId}/gohighlevel/decrypt. These two vars are how this
# service reaches key-service; without them the sync fails loud.
KEY_SERVICE_URL='http://key-service:8080'
KEY_SERVICE_API_KEY='your-key-service-api-key'

# Optional tuning (defaults shown)
# GOHIGHLEVEL_TIMEOUT_MS=20000
# GOHIGHLEVEL_MAX_PAGES=200
